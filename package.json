{
  "name": "ai-telegram-bot",
  "version": "1.0.0",
  "description": "Universal AI Assistant Telegram Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:miniapp": "cd miniapp && npm run dev",
    "build:miniapp": "cd miniapp && npm run build",
    "build:backend": "tsc",
    "build": "npm run build:miniapp && npm run build:backend",
    "start": "node dist/index.js",
    "postinstall": "cd miniapp && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "openai": "^4.63.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
